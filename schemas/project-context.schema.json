{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-os.local/schemas/project-context.schema.json",
  "title": "Context OS Project Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "language",
    "profile",
    "facts",
    "accepted_proposals",
    "assumptions",
    "open_questions",
    "constraints",
    "exclusions",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "purpose"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "profile": {
      "type": "string",
      "enum": ["compact", "detailed"]
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "accepted_proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "impact", "blocking"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
