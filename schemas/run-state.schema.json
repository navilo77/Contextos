{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-os.local/schemas/run-state.schema.json",
  "title": "Context OS Durable Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "project_id", "status", "revision", "created_at", "updated_at"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "awaiting_user", "blocked", "completed", "failed", "cancelled"]
    },
    "stage": {
      "type": ["string", "null"],
      "maxLength": 80
    },
    "progress": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "interrupt": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["clarification", "review_approval"]
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "retryable"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "blocker": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "reference"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "completed_revision": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "export_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "awaiting_user"}},
        "required": ["status"]
      },
      "then": {
        "required": ["interrupt"],
        "properties": {"interrupt": {"type": "object"}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "failed"}},
        "required": ["status"]
      },
      "then": {
        "required": ["error"],
        "properties": {"error": {"type": "object"}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "blocked"}},
        "required": ["status"]
      },
      "then": {
        "required": ["blocker"],
        "properties": {"blocker": {"type": "object"}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "completed"}},
        "required": ["status"]
      },
      "then": {
        "required": ["completed_revision", "export_id"],
        "properties": {
          "completed_revision": {"type": "integer"},
          "export_id": {"type": "string", "format": "uuid"}
        }
      }
    }
  ]
}
